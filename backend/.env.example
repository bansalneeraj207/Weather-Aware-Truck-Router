# Local development uses SQLite when DATABASE_URL is omitted.
DJANGO_ENV=development
DEBUG=1
DJANGO_SECRET_KEY=local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173

# Production example (set real values only in Render, never in this file):
# DJANGO_ENV=production
# DEBUG=0
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# DJANGO_SECRET_KEY=replace-with-a-generated-secret
# ALLOWED_HOSTS=your-api.onrender.com
# FRONTEND_ORIGINS=https://your-frontend.onrender.com
# PROVIDER_USER_AGENT=WeatherAwareTruckRouter/1.0 (contact: https://example.com)
# VALHALLA_CLIENT_ID=your-unique-demo-name

# Optional provider switches. Defaults use the public services in README.md.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# GEOCODING_CACHE_SECONDS=604800
